class Book:
    def __init__(self, book_id, title, author):
        self.book_id = book_id
        self.title = title
        self.author = author


class Patron:
    def __init__(self, name, id):
        self.name = name
        self.id = id


class Library:
    def __init__(self):
        self.books = []

    def add(self):
        title = input("ENTER THE BOOK NAME: ")
        book_id = input("ENTER THE BOOK ID: ")
        author = input("ENTER THE AUTHOR NAME: ")

        book = Book(book_id, title, author)
        self.books.append(book)

        print("Book added successfully!")

    def display(self):
        if not self.books:
            print("No books in library.")
            return

        print("\nBooks Present:")
        for b in self.books:
            print(f"ID: {b.book_id} | Title: {b.title} | Author: {b.author}")

    def browse(self):
        title = input("ENTER THE BOOK NAME TO SEARCH: ")

        for b in self.books:
            if b.title.lower() == title.lower():
                print(f"Book Found!")
                print(f"ID: {b.book_id}")
                print(f"Title: {b.title}")
                print(f"Author: {b.author}")
                return

        print("Book not found.")


library = Library()

while True:
    print("""
Welcome to Library
1. Add Book
2. Browse Book
3. Display Books
4. Exit
""")

    opt = int(input("Choose an option: "))

    if opt == 1:
        library.add()

    elif opt == 2:
        library.browse()

    elif opt == 3:
        library.display()

    elif opt == 4:
        print("Exiting...")
        break

    else:
        print("Invalid option. Choose again.")
